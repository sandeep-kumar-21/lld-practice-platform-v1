# Database (MySQL via Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/lld_practice_platform"

# Redis & Queue
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Application Ports
API_PORT=4000

# Evaluation Engine Configuration (rule_based | openrouter | mock)
# "rule_based": Primary recommended default — 100% free, offline, instant (<20ms), zero rate-limits
# "openrouter": Optional remote cloud LLM
# "mock": Deterministic offline test double
LLM_PROVIDER="rule_based"

# OpenRouter Configuration (only needed if LLM_PROVIDER="openrouter")
LLM_MODEL="poolside/laguna-s-2.1:free"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Evaluation Queue Config
EVALUATION_QUEUE_NAME="evaluation"
EVALUATION_MAX_RETRIES=4
EVALUATION_BACKOFF_DELAY_MS=15000
EVALUATION_TIMEOUT_MS=30000

